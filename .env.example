# Next.js (.env.local, git-ignored). `npx convex dev` writes the two Convex URLs for you.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_DEPLOYMENT=

# Clerk. Leave empty to run in Clerk keyless mode during development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The following live on the Convex deployment, not in .env.local:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-instance>.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-events
#   npx convex env set N8N_WEBHOOK_SECRET <openssl rand -hex 32>
#   npx convex env set N8N_INBOUND_SECRET <openssl rand -hex 32>
