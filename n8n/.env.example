# Copy to n8n/.env (git-ignored). Generate each secret with: openssl rand -hex 32
# Encrypts the credentials n8n stores (Clerk key, SMTP) at rest.
N8N_ENCRYPTION_KEY=

# Must equal N8N_WEBHOOK_SECRET on the Convex deployment (Convex signs, n8n verifies).
LENDLOOP_WEBHOOK_SECRET=
# Must equal N8N_INBOUND_SECRET on the Convex deployment (n8n signs, Convex verifies).
LENDLOOP_INBOUND_SECRET=
# Convex HTTP actions URL. Local Convex backend seen from inside Docker:
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
